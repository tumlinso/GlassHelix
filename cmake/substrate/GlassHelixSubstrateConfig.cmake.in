@PACKAGE_INIT@
set(GlassHelixSubstrate_contracts_FOUND TRUE)
set(GlassHelixSubstrate_native_FOUND @GLASSHELIX_SUBSTRATE_BUILD_NATIVE@)
set(GlassHelixSubstrate_analysis_FOUND @GLASSHELIX_SUBSTRATE_BUILD_ANALYSIS@)
set(GlassHelixSubstrate_framework_FOUND @GLASSHELIX_SUBSTRATE_INSTALL_FRAMEWORK@)
include("${CMAKE_CURRENT_LIST_DIR}/GlassHelixSubstrateTargets.cmake")
if(GlassHelixSubstrate_native_FOUND AND "native" IN_LIST GlassHelixSubstrate_FIND_COMPONENTS)
  include(CMakeFindDependencyMacro)
  find_dependency(Cellerator CONFIG COMPONENTS native_foundation indexed_mechanism)
  include("${CMAKE_CURRENT_LIST_DIR}/GlassHelixSubstrateNativeTargets.cmake")
endif()
if(GlassHelixSubstrate_analysis_FOUND AND "analysis" IN_LIST GlassHelixSubstrate_FIND_COMPONENTS)
  include(CMakeFindDependencyMacro)
  find_dependency(Cellerator CONFIG COMPONENTS local_differential)
  find_dependency(CUDAToolkit)
  include("${CMAKE_CURRENT_LIST_DIR}/GlassHelixSubstrateAnalysisTargets.cmake")
endif()
check_required_components(GlassHelixSubstrate)
